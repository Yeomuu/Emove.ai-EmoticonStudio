# Browser-exposed values must use NEXT_PUBLIC_. Never expose OPENAI_API_KEY.
NEXT_PUBLIC_AI_MODE=openai

# Server-only OpenAI values. Set these in .env.local and Vercel Project Environment Variables.
OPENAI_API_KEY=
OPENAI_PROMPT_MODEL=gpt-5.5-2026-04-23
OPENAI_TRANSCRIBE_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_BACKGROUND=auto
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=webp
OPENAI_IMAGE_OUTPUT_COMPRESSION=82
OPENAI_IMAGE_CONCURRENCY=1
OPENAI_CHARACTER_VARIATIONS=1

# Optional voice-emotion provider. Server-only; never prefix with NEXT_PUBLIC_.
# Imentiv file uploads accept WAV/MP3/AAC/M4A, so the client converts its short WebM capture to WAV.
IMENTIV_API_KEY=
IMENTIV_API_BASE_URL=https://api.imentiv.ai

# Optional external proxy. Leave empty for same-origin Next Route Handler /api/openai/*.
NEXT_PUBLIC_OPENAI_API_BASE=

# Optional external share API. Leave empty for same-origin /api/share/gif.
NEXT_PUBLIC_SHARE_API_BASE=

# Google Cloud Storage. The default private-bucket path is served through /api/assets/file.
GCS_BUCKET_NAME=emove-emotion
# Optional: a public CDN base URL. Leave empty to keep the bucket private.
GCS_PUBLIC_BASE_URL=
# Optional local/custom-domain override. Vercel uses VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=
GOOGLE_CLOUD_PROJECT=emove-aiemoticonstudio
GOOGLE_CLOUD_CLIENT_EMAIL=
# In Vercel, paste the JSON private_key value; escaped \\n sequences are supported.
GOOGLE_CLOUD_PRIVATE_KEY=

# Recommended metadata DB: Neon Postgres through Vercel Marketplace.
# If empty, the app keeps local IndexedDB persistence only.
DATABASE_URL=
NEXT_PUBLIC_LIBRARY_API_BASE=

# MediaPipe public assets.
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=/models/wasm
NEXT_PUBLIC_POSE_MODEL_PATH=/models/pose_landmarker_lite.task
NEXT_PUBLIC_FACE_MODEL_PATH=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
