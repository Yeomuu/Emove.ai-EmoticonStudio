# OpenAI는 기본적으로 Mock 모드입니다. API 키를 VITE_ 변수로 노출하지 마세요.
VITE_AI_MODE=mock

# 실제 API 검증 시에만 .env.local에 추가합니다. 브라우저에 노출되지 않는 서버 변수입니다.
OPENAI_API_KEY=
OPENAI_PROMPT_MODEL=gpt-5.5-2026-04-23
OPENAI_TRANSCRIBE_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_BACKGROUND=auto
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_CONCURRENCY=2

# 선택: Firebase 웹 설정 JSON. 비어 있으면 IndexedDB만 사용합니다.
# 콘솔에서 Web App을 만든 뒤 Authentication > Anonymous, Firestore, Storage를 켜야 동기화됩니다.
VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","measurementId":""}

# 기본값은 프로젝트에 포함된 로컬 MediaPipe 파일입니다.
VITE_MEDIAPIPE_WASM_PATH=/models/wasm
VITE_POSE_MODEL_PATH=/models/pose_landmarker_lite.task
