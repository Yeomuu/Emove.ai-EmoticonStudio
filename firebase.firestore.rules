rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    match /stickers/{stickerId} {
      allow read: if resource.data.isDefault == true || resource.data.isPublished == true || owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /characters/{characterId} {
      allow read: if resource.data.isDefault == true || resource.data.isPublished == true || owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /projects/{projectId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /captures/{captureId} {
      allow create: if owns(request.resource.data);
      allow read, update, delete: if owns(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
    }
  }
}
